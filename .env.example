# Server-side LI.FI API key. Set this in Vercel Environment Variables.
# Do not use VITE_ prefix; VITE_ variables are exposed to the browser.
LIFI_API_KEY=your_lifi_api_key_here

# On-chain referral registry (after deploying PioReferralRegistry.sol)
VITE_REFERRAL_REGISTRY_ADDRESS=0xYourDeployedRegistryAddress
# Optional public JSON-RPC endpoint for receipt confirmation polling
VITE_REFERRAL_RPC_URL=https://your-chain-rpc.example
