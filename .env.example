# Public client configuration. These are contract addresses / IDs, not private keys.
# Copy to .env.local and fill in only after you deploy and verify the contracts.

# Existing src/integrations.ts reads this in the browser (and it becomes public in the built JS).
# Only use a LI.FI key intended for public client use; for a private key, add a server-side proxy first.
VITE_LIFI_API_KEY=
# Optional backend/proxy secret; the current Vite client does not read this value. Keep it server-only.
LIFI_API_KEY=

# PIO token identity (required for all PIO on-chain actions)
VITE_PIO_TOKEN_ADDRESS=
VITE_PIO_DECIMALS=18
VITE_EVM_CHAIN_ID=

# Liquidity: Uniswap V2-compatible router and token addresses on ONE chain.
# If you use a different AMM, its ABI/call flow needs a matching adapter instead.
VITE_LP_CHAIN_ID=
VITE_LP_ROUTER_ADDRESS=
VITE_USDC_TOKEN_ADDRESS=
VITE_USDC_DECIMALS=6
VITE_WETH_TOKEN_ADDRESS=
VITE_WETH_DECIMALS=18
VITE_LP_TOKEN_DECIMALS=18
VITE_PIO_USDC_LP_TOKEN_ADDRESS=
VITE_PIO_WETH_LP_TOKEN_ADDRESS=

# Staking contract: deploy contracts/src/PioStakingRewards.sol and fund its reward schedule first.
VITE_STAKING_CHAIN_ID=
VITE_PIO_STAKING_CONTRACT_ADDRESS=
VITE_STAKING_TOKEN_ADDRESS=
VITE_STAKING_TOKEN_SYMBOL=PIO
VITE_STAKING_TOKEN_DECIMALS=18
VITE_STAKING_REWARD_SYMBOL=PIO
VITE_STAKING_REWARD_TOKEN_ADDRESS=
VITE_STAKING_REWARD_DECIMALS=18

# Referral distributor: binds referrers on-chain. Payouts occur only if the real fee collector calls distributeFee.
VITE_REFERRAL_CHAIN_ID=
VITE_PIO_REFERRAL_DISTRIBUTOR_ADDRESS=

# Optional sponsored banner creative (client-visible URLs only).
VITE_AD_BANNER_TITLE=Partner spotlight
VITE_AD_BANNER_COPY=Reach PioSwap users exploring digital assets and on-chain finance.
VITE_AD_BANNER_URL=
VITE_AD_BANNER_IMAGE_URL=
