# Gemini server key from Google AI Studio. Keep server-side only (no VITE_ prefix).
GEMINI_API_KEY=replace_with_your_gemini_api_key
# Recommended stable model for new Gemini API projects; verify account availability.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional LI.FI API key. VITE_ values are bundled into the browser and are public.
VITE_LIFI_API_KEY=optional_public_lifi_api_key

# Local Express API port only. Do not add this variable to Vercel.
API_PORT=3001
